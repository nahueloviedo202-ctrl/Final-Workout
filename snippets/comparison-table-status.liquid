{%- doc -%}
  Renders the check-mark / cross-mark badge used inside a comparison-table cell.

  @param {string} status - 'check' or 'cross'
  @param {object} section_settings - the parent comparison-table section's settings object

  @example
  {% render 'comparison-table-status', status: 'check', section_settings: section.settings %}
{%- enddoc -%}

{% liquid
  if status == 'check'
    assign icon_color = section_settings.check_icon_color | default: '#ffffff'
    assign icon_background = section_settings.check_background_color | default: '#53af01'
  else
    assign icon_color = section_settings.cross_icon_color | default: '#121212'
    assign icon_background = section_settings.cross_background_color | default: '#dbdbdb'
  endif
%}

<div
  class="comparison-table__icon"
  style="--icon-color: {{ icon_color }}; --icon-background: {{ icon_background }};"
>
  {% if status == 'check' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M438.6 105.4c12.5 12.5 12.5 32.8 0 45.3l-256 256c-12.5 12.5-32.8 12.5-45.3 0l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L160 338.7 393.4 105.4c12.5-12.5 32.8-12.5 45.3 0z" />
    </svg>
  {% else %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3 297.4 406.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256 342.6 150.6z" />
    </svg>
  {% endif %}
</div>

{% stylesheet %}
  .comparison-table__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background-color: var(--icon-background);
    color: var(--icon-color);
  }

  .comparison-table__icon svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }
{% endstylesheet %}
