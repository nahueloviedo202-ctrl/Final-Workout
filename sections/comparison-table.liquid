{%- comment -%}
  Comparison table section.

  Renders a heading/sub-text block side-by-side with a compact comparison table (stacked on
  mobile) with a highlighted "your brand" column and an "others" column. Each feature row is a
  `comparison-table-row` block so merchants can add, remove, reorder and edit rows from the Theme
  Editor. Column colors, the check/cross badge colors, table radius and typography are all
  editable section settings.
{%- endcomment -%}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign brand_heading = section.settings.brand_column_heading | default: shop.name
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    comparison-table-section
    spacing-style
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --comparison-heading-size-mobile: {{ section.settings.heading_font_size_mobile | default: 28 }}px;
    --comparison-heading-size-desktop: {{ section.settings.heading_font_size_desktop | default: 40 }}px;
    --comparison-subheading-size-mobile: {{ section.settings.subheading_font_size_mobile | default: 15 }}px;
    --comparison-subheading-size-desktop: {{ section.settings.subheading_font_size_desktop | default: 16 }}px;
    --comparison-cell-size-mobile: {{ section.settings.cell_font_size_mobile | default: 12 }}px;
    --comparison-cell-size-desktop: {{ section.settings.cell_font_size_desktop | default: 14 }}px;
    --comparison-header-size-mobile: {{ section.settings.header_font_size_mobile | default: 14 }}px;
    --comparison-header-size-desktop: {{ section.settings.header_font_size_desktop | default: 16 }}px;
  "
>
  <div class="comparison-table-section__layout">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div
        class="comparison-table-section__content"
        style="text-align: {{ section.settings.heading_alignment }};"
      >
        {% if section.settings.heading != blank %}
          <h2
            class="comparison-table-section__heading {{ section.settings.heading_type_preset }}"
            style="font-size: var(--comparison-heading-size);"
          >
            {{- section.settings.heading -}}
          </h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="comparison-table-section__subheading rte">
            {{ section.settings.subheading }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="comparison-table-section__table-wrapper">
      <table
        class="comparison-table"
        style="--border-radius: {{ section.settings.border_radius }}px;"
      >
        <thead>
          <tr>
            <th class="comparison-table__cell comparison-table__cell--label"></th>
            <th
              class="comparison-table__cell comparison-table__cell--highlighted"
              style="{% render 'comparison-table-cell-style', background_color: section.settings.highlighted_column_background_color, text_color: section.settings.highlighted_column_text_color %}"
            >
              {{ brand_heading }}
            </th>
            <th
              class="comparison-table__cell comparison-table__cell--regular"
              style="{% render 'comparison-table-cell-style', background_color: section.settings.regular_cell_background_color, text_color: section.settings.regular_cell_text_color %}"
            >
              {{ section.settings.others_column_heading }}
            </th>
          </tr>
        </thead>
        <tbody>
          {% content_for 'blocks' %}
        </tbody>
      </table>
    </div>
  </div>
</div>

{% stylesheet %}
  .comparison-table-section__layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3.2rem;
  }

  .comparison-table-section__content {
    max-width: 38rem;
    --comparison-heading-size: var(--comparison-heading-size-mobile, 2.8rem);
  }

  .comparison-table-section__heading {
    margin: 0;
  }

  .comparison-table-section__subheading {
    margin-block-start: 1.2rem;
    font-size: var(--comparison-subheading-size-mobile, 1.5rem);
  }

  .comparison-table-section__subheading :is(p) {
    margin: 0;
  }

  .comparison-table-section__table-wrapper {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: visible;
    padding-block: 1.2rem;
  }

  .comparison-table {
    border-collapse: separate;
    border-spacing: 0;
  }

  .comparison-table__cell {
    background-color: var(--cell-background, transparent);
    color: var(--cell-color, inherit);
    padding: 1.2rem 1.6rem;
    text-align: center;
    vertical-align: middle;
    font-size: var(--comparison-cell-size-desktop, 1.4rem);
    min-width: 7.5rem;
  }

  .comparison-table__cell--label {
    text-align: start;
    min-width: 13rem;
  }

  th.comparison-table__cell--highlighted,
  th.comparison-table__cell--regular {
    font-size: var(--comparison-header-size-desktop, 1.6rem);
    font-weight: 600;
  }

  .comparison-table tbody tr:not(:last-child) .comparison-table__cell--label,
  .comparison-table tbody tr:not(:last-child) .comparison-table__cell--regular {
    box-shadow: inset 0 -1px 0 0 rgb(var(--color-foreground-rgb) / 0.1);
  }

  /* The highlighted column reads as its own rounded, elevated "pill" spanning every row.
     Only its first (header) and last (final row) cells get corners, and every cell in the
     column gets the same drop shadow — internal seams stay hidden because each cell's opaque
     background paints over the shadow bled from its neighbor, leaving one continuous shadow
     around the outside of the column. Raising the stacking context (position + z-index) keeps
     that shadow visible above the plain label/others cells sitting beside it. */
  .comparison-table__cell--highlighted {
    position: relative;
    z-index: var(--layer-raised, 1);
    box-shadow: 0 12px 20px -6px rgb(0 0 0 / 0.3);
  }

  .comparison-table thead .comparison-table__cell--highlighted {
    border-start-start-radius: var(--border-radius, 0);
    border-start-end-radius: var(--border-radius, 0);
  }

  .comparison-table tbody tr:last-child .comparison-table__cell--highlighted {
    border-end-start-radius: var(--border-radius, 0);
    border-end-end-radius: var(--border-radius, 0);
  }

  @media screen and (min-width: 750px) {
    .comparison-table-section__layout {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      flex-wrap: nowrap;
      gap: 4rem;
    }

    .comparison-table-section__content {
      flex: 1 1 40%;
      --comparison-heading-size: var(--comparison-heading-size-desktop, 4rem);
    }

    .comparison-table-section__table-wrapper {
      flex: 0 0 auto;
    }

    .comparison-table-section__subheading {
      font-size: var(--comparison-subheading-size-desktop, 1.6rem);
    }
  }

  @media screen and (max-width: 749px) {
    .comparison-table__cell {
      padding: 0.8rem 0.6rem;
      font-size: var(--comparison-cell-size-mobile, 1.2rem);
      min-width: 5rem;
    }

    .comparison-table__cell--label {
      min-width: 8.5rem;
    }

    th.comparison-table__cell--highlighted,
    th.comparison-table__cell--regular {
      font-size: var(--comparison-header-size-mobile, 1.4rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "section-comparison-table",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "comparison-table-row"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Us"
    },
    {
      "type": "select",
      "id": "heading_type_preset",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Extra large" },
        { "value": "h2", "label": "Large" },
        { "value": "h3", "label": "Medium" },
        { "value": "h4", "label": "Small" }
      ],
      "default": "h1"
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "label": "Heading size (desktop)",
      "min": 20,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "text_alignment",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "left"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Discover what sets us apart from the competition. We're committed to delivering exceptional quality, outstanding customer service, and unbeatable value on every purchase.</p>"
    },
    {
      "type": "range",
      "id": "subheading_font_size_desktop",
      "label": "Subheading size (desktop)",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_font_size_mobile",
      "label": "Subheading size (mobile)",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Table text size"
    },
    {
      "type": "range",
      "id": "header_font_size_desktop",
      "label": "Column heading size (desktop)",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "header_font_size_mobile",
      "label": "Column heading size (mobile)",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "cell_font_size_desktop",
      "label": "Row text size (desktop)",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "cell_font_size_mobile",
      "label": "Row text size (mobile)",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Table corner radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "\"Your brand\" column"
    },
    {
      "type": "text",
      "id": "brand_column_heading",
      "label": "Column heading",
      "placeholder": "Defaults to shop name"
    },
    {
      "type": "color",
      "id": "highlighted_column_background_color",
      "label": "Background color",
      "default": "#2e2a39"
    },
    {
      "type": "color",
      "id": "highlighted_column_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "\"Others\" column"
    },
    {
      "type": "text",
      "id": "others_column_heading",
      "label": "Column heading",
      "default": "Others"
    },
    {
      "type": "color",
      "id": "regular_cell_background_color",
      "label": "Background color",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "regular_cell_text_color",
      "label": "Text color",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Check mark"
    },
    {
      "type": "color",
      "id": "check_icon_color",
      "label": "Icon color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "check_background_color",
      "label": "Background color",
      "default": "#53af01"
    },
    {
      "type": "header",
      "content": "Cross mark"
    },
    {
      "type": "color",
      "id": "cross_icon_color",
      "label": "Icon color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "cross_background_color",
      "label": "Background color",
      "default": "#dbdbdb"
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "category": "Storytelling",
      "settings": {
        "heading": "Why Choose Us",
        "heading_type_preset": "h1",
        "heading_alignment": "left",
        "subheading": "<p>Discover what sets us apart from the competition. We're committed to delivering exceptional quality, outstanding customer service, and unbeatable value on every purchase.</p>",
        "section_width": "page-width",
        "border_radius": 32,
        "highlighted_column_background_color": "#2e2a39",
        "highlighted_column_text_color": "#ffffff",
        "others_column_heading": "Others",
        "check_icon_color": "#ffffff",
        "check_background_color": "#53af01",
        "cross_icon_color": "#121212",
        "cross_background_color": "#dbdbdb",
        "padding-block-start": 36,
        "padding-block-end": 36
      },
      "blocks": {
        "row_1": {
          "type": "comparison-table-row",
          "settings": {
            "row_label": "Fast & Free Shipping",
            "your_brand_status": "check",
            "others_status": "cross"
          }
        },
        "row_2": {
          "type": "comparison-table-row",
          "settings": {
            "row_label": "24/7 Customer Support",
            "your_brand_status": "check",
            "others_status": "cross"
          }
        },
        "row_3": {
          "type": "comparison-table-row",
          "settings": {
            "row_label": "Quality Guaranteed",
            "your_brand_status": "check",
            "others_status": "cross"
          }
        }
      },
      "block_order": ["row_1", "row_2", "row_3"]
    }
  ]
}
{% endschema %}
