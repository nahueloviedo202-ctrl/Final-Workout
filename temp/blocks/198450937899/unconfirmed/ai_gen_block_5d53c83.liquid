{% doc %}
  @prompt
    HAZME LO MISMO QUE AQUI: SECCION DE POLICY LINKS PERO AÑADE CONTACT INFORMATION Y LEGAL NOTICE
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-links-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-footer-links-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.spacing }}px;
  }

  .ai-footer-links-section-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.link_spacing }}px;
  }

  .ai-footer-links-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
    margin: 0;
    text-transform: {{ block.settings.heading_text_transform }};
  }

  .ai-footer-links-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.link_spacing }}px;
  }

  .ai-footer-links-item-{{ ai_gen_id }} {
    margin: 0;
  }

  .ai-footer-links-link-{{ ai_gen_id }} {
    font-size: {{ block.settings.link_size }}px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-block;
  }

  .ai-footer-links-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-footer-links-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.link_size }}px;
    color: {{ block.settings.link_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-footer-links-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<footer-links-{{ ai_gen_id }}
  class="ai-footer-links-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-footer-links-container-{{ ai_gen_id }}">
    {% if block.settings.show_policy_links %}
      <div class="ai-footer-links-section-{{ ai_gen_id }}">
        {% if block.settings.policy_heading != blank %}
          <h3 class="ai-footer-links-heading-{{ ai_gen_id }}">{{ block.settings.policy_heading }}</h3>
        {% endif %}
        <ul class="ai-footer-links-list-{{ ai_gen_id }}">
          {% if shop.privacy_policy %}
            <li class="ai-footer-links-item-{{ ai_gen_id }}">
              <a
                href="{{ shop.privacy_policy.url }}"
                class="ai-footer-links-link-{{ ai_gen_id }}"
              >
                {{ shop.privacy_policy.title }}
              </a>
            </li>
          {% endif %}
          {% if shop.refund_policy %}
            <li class="ai-footer-links-item-{{ ai_gen_id }}">
              <a
                href="{{ shop.refund_policy.url }}"
                class="ai-footer-links-link-{{ ai_gen_id }}"
              >
                {{ shop.refund_policy.title }}
              </a>
            </li>
          {% endif %}
          {% if shop.shipping_policy %}
            <li class="ai-footer-links-item-{{ ai_gen_id }}">
              <a
                href="{{ shop.shipping_policy.url }}"
                class="ai-footer-links-link-{{ ai_gen_id }}"
              >
                {{ shop.shipping_policy.title }}
              </a>
            </li>
          {% endif %}
          {% if shop.terms_of_service %}
            <li class="ai-footer-links-item-{{ ai_gen_id }}">
              <a
                href="{{ shop.terms_of_service.url }}"
                class="ai-footer-links-link-{{ ai_gen_id }}"
              >
                {{ shop.terms_of_service.title }}
              </a>
            </li>
          {% endif %}
        </ul>
      </div>
    {% endif %}

    {% if block.settings.show_contact_info %}
      <div class="ai-footer-links-section-{{ ai_gen_id }}">
        {% if block.settings.contact_heading != blank %}
          <h3 class="ai-footer-links-heading-{{ ai_gen_id }}">{{ block.settings.contact_heading }}</h3>
        {% endif %}
        <ul class="ai-footer-links-list-{{ ai_gen_id }}">
          {% if block.settings.contact_email != blank %}
            <li class="ai-footer-links-item-{{ ai_gen_id }}">
              <a
                href="mailto:{{ block.settings.contact_email }}"
                class="ai-footer-links-link-{{ ai_gen_id }}"
              >
                {{ block.settings.contact_email }}
              </a>
            </li>
          {% endif %}
          {% if block.settings.contact_phone != blank %}
            <li class="ai-footer-links-item-{{ ai_gen_id }}">
              <a
                href="tel:{{ block.settings.contact_phone }}"
                class="ai-footer-links-link-{{ ai_gen_id }}"
              >
                {{ block.settings.contact_phone }}
              </a>
            </li>
          {% endif %}
          {% if block.settings.contact_address != blank %}
            <li class="ai-footer-links-item-{{ ai_gen_id }}">
              <p class="ai-footer-links-text-{{ ai_gen_id }}">{{ block.settings.contact_address }}</p>
            </li>
          {% endif %}
        </ul>
      </div>
    {% endif %}

    {% if block.settings.show_legal_notice %}
      <div class="ai-footer-links-section-{{ ai_gen_id }}">
        {% if block.settings.legal_heading != blank %}
          <h3 class="ai-footer-links-heading-{{ ai_gen_id }}">{{ block.settings.legal_heading }}</h3>
        {% endif %}
        {% if block.settings.legal_text != blank %}
          <div class="ai-footer-links-text-{{ ai_gen_id }}">
            {{ block.settings.legal_text }}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</footer-links-{{ ai_gen_id }}>

<script>
  (function() {
    class FooterLinks{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('footer-links-{{ ai_gen_id }}', FooterLinks{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Policy and contact links",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Policy links"
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "text",
      "id": "policy_heading",
      "label": "Heading",
      "default": "Policies"
    },
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "checkbox",
      "id": "show_contact_info",
      "label": "Show contact information",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Heading",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Phone"
    },
    {
      "type": "textarea",
      "id": "contact_address",
      "label": "Address"
    },
    {
      "type": "header",
      "content": "Legal notice"
    },
    {
      "type": "checkbox",
      "id": "show_legal_notice",
      "label": "Show legal notice",
      "default": true
    },
    {
      "type": "text",
      "id": "legal_heading",
      "label": "Heading",
      "default": "Legal notice"
    },
    {
      "type": "richtext",
      "id": "legal_text",
      "label": "Text",
      "default": "<p>All rights reserved.</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Section spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "link_spacing",
      "label": "Link spacing",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "heading_text_transform",
      "label": "Heading text case",
      "options": [
        {
          "value": "none",
          "label": "Default"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "link_size",
      "label": "Link size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "Policy and contact links"
    }
  ]
}
{% endschema %}
