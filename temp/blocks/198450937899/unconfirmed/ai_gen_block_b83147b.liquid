{% doc %}
  @prompt
    HAZME EL LINKS DE MIS PLITICAS EN LINEA COMO EN LA SECCION QUE HE CREADO BAJO, PERO INCLUYE TODAS, LA DE LEGAL TAMBIEN Y LA DE CONTACT
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-policy-links-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-policy-links-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.link_spacing }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-policy-links-item-{{ ai_gen_id }} {
    margin: 0;
  }

  .ai-policy-links-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: {{ block.settings.link_underline }};
    font-size: {{ block.settings.font_size }}px;
    transition: color 0.3s ease;
    display: inline-block;
  }

  .ai-policy-links-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-policy-links-list-{{ ai_gen_id }} {
      gap: {{ block.settings.link_spacing_mobile }}px;
    }

    .ai-policy-links-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-policy-links-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <ul class="ai-policy-links-list-{{ ai_gen_id }}">
    {% if shop.privacy_policy %}
      <li class="ai-policy-links-item-{{ ai_gen_id }}">
        <a href="{{ shop.privacy_policy.url }}" class="ai-policy-links-link-{{ ai_gen_id }}">
          {{ shop.privacy_policy.title }}
        </a>
      </li>
    {% endif %}

    {% if shop.refund_policy %}
      <li class="ai-policy-links-item-{{ ai_gen_id }}">
        <a href="{{ shop.refund_policy.url }}" class="ai-policy-links-link-{{ ai_gen_id }}">
          {{ shop.refund_policy.title }}
        </a>
      </li>
    {% endif %}

    {% if shop.shipping_policy %}
      <li class="ai-policy-links-item-{{ ai_gen_id }}">
        <a href="{{ shop.shipping_policy.url }}" class="ai-policy-links-link-{{ ai_gen_id }}">
          {{ shop.shipping_policy.title }}
        </a>
      </li>
    {% endif %}

    {% if shop.terms_of_service %}
      <li class="ai-policy-links-item-{{ ai_gen_id }}">
        <a href="{{ shop.terms_of_service.url }}" class="ai-policy-links-link-{{ ai_gen_id }}">
          {{ shop.terms_of_service.title }}
        </a>
      </li>
    {% endif %}

    {% if shop.subscription_policy %}
      <li class="ai-policy-links-item-{{ ai_gen_id }}">
        <a href="{{ shop.subscription_policy.url }}" class="ai-policy-links-link-{{ ai_gen_id }}">
          {{ shop.subscription_policy.title }}
        </a>
      </li>
    {% endif %}

    {% if block.settings.show_legal_notice and block.settings.legal_notice_page %}
      <li class="ai-policy-links-item-{{ ai_gen_id }}">
        <a href="{{ block.settings.legal_notice_page.url }}" class="ai-policy-links-link-{{ ai_gen_id }}">
          {{ block.settings.legal_notice_page.title }}
        </a>
      </li>
    {% endif %}

    {% if block.settings.show_contact and block.settings.contact_page %}
      <li class="ai-policy-links-item-{{ ai_gen_id }}">
        <a href="{{ block.settings.contact_page.url }}" class="ai-policy-links-link-{{ ai_gen_id }}">
          {{ block.settings.contact_page.title }}
        </a>
      </li>
    {% endif %}
  </ul>
</div>

{% schema %}
{
  "name": "Policy links",
  "settings": [
    {
      "type": "header",
      "content": "Additional pages"
    },
    {
      "type": "checkbox",
      "id": "show_legal_notice",
      "label": "Show legal notice",
      "default": false
    },
    {
      "type": "page",
      "id": "legal_notice_page",
      "label": "Legal notice page"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show contact",
      "default": false
    },
    {
      "type": "page",
      "id": "contact_page",
      "label": "Contact page"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#666666"
    },
    {
      "type": "select",
      "id": "link_underline",
      "label": "Link underline",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "underline",
          "label": "Underline"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Mobile font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "link_spacing",
      "label": "Desktop link spacing",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "link_spacing_mobile",
      "label": "Mobile link spacing",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Policy links"
    }
  ]
}
{% endschema %}
