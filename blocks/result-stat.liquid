{%- doc -%}
  Renders a single result row: a circular percentage ring followed by a short description.
  Used inside the `results` section's stat list.

  Reads the ring's size/thickness/colors from the parent section so every stat in the list
  stays visually consistent, while the percentage and text stay fully editable per block.
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign section_settings = section.settings

  assign ring_size = section_settings.ring_size | default: 70
  assign ring_thickness = section_settings.ring_thickness | default: 7
  assign ring_center = ring_size | divided_by: 2.0
  assign half_thickness = ring_thickness | divided_by: 2.0
  assign radius = ring_center | minus: half_thickness | minus: 0.5

  assign track_color = section_settings.ring_track_color
  if track_color == blank and section_settings.ring_color != blank
    assign track_color = 'rgb(' | append: section_settings.ring_color.rgb | append: ' / 0.15)'
  endif
%}

<div class="result-stat" {{ block.shopify_attributes }}>
  <div
    class="result-stat__ring"
    style="
      width: {{ ring_size }}px;
      height: {{ ring_size }}px;
      {% if section_settings.ring_color != blank %}--ring-color: {{ section_settings.ring_color }};{% endif %}
      {% if track_color != blank %}--ring-track-color: {{ track_color }};{% endif %}
    "
  >
    <svg
      class="result-stat__ring-svg"
      viewBox="0 0 {{ ring_size }} {{ ring_size }}"
      aria-hidden="true"
      focusable="false"
    >
      <circle
        class="result-stat__ring-track"
        cx="{{ ring_center }}"
        cy="{{ ring_center }}"
        r="{{ radius }}"
        fill="none"
        stroke-width="{{ ring_thickness }}"
      />
      <circle
        class="result-stat__ring-progress"
        cx="{{ ring_center }}"
        cy="{{ ring_center }}"
        r="{{ radius }}"
        fill="none"
        stroke-width="{{ ring_thickness }}"
        stroke-linecap="round"
        pathLength="100"
        stroke-dasharray="{{ block_settings.percentage }} 100"
        transform="rotate(-90 {{ ring_center }} {{ ring_center }})"
      />
    </svg>
    <p class="result-stat__ring-label">{{ block_settings.percentage }}%</p>
  </div>

  {% if block_settings.text != blank %}
    <div class="result-stat__text rte">
      {{ block_settings.text }}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .result-stat {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    padding-block-start: 1.6rem;
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
  }

  .result-stat:first-child {
    padding-block-start: 0;
    border-block-start: none;
  }

  .result-stat__ring {
    position: relative;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .result-stat__ring-svg {
    width: 100%;
    height: 100%;
  }

  .result-stat__ring-track {
    stroke: var(--ring-track-color, rgb(var(--color-foreground-rgb) / 0.15));
  }

  .result-stat__ring-progress {
    stroke: var(--ring-color, var(--color-foreground));
  }

  .result-stat__ring-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--ring-color, var(--color-foreground));
  }

  .result-stat__text {
    flex: 1 1 auto;
  }

  .result-stat__text :is(p) {
    margin: 0;
    line-height: 1.6;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Result stat",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "percentage",
      "label": "Percentage",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 94
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our users love how these recipes transform their everyday meals from the first attempt, with simple ingredients and easy-to-follow steps.</p>"
    }
  ],
  "presets": [
    {
      "name": "Result stat",
      "settings": {
        "percentage": 94,
        "text": "<p>Our users love how these recipes transform their everyday meals from the first attempt, with simple ingredients and easy-to-follow steps.</p>"
      }
    }
  ]
}
{% endschema %}
